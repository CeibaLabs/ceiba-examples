# Ceiba Runtime (must be running and configured for your project)
CEIBA_RUNTIME_URL=http://localhost:8080

# From your Ceiba project (Runtime transport auth + authorize body)
CEIBA_PROJECT_ID=00000000-0000-4000-8000-000000000000
CEIBA_PROJECT_SECRET=replace-with-project-secret

# App listen port
PORT=3000
